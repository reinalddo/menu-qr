# menu-qr settings.
# On Hostinger you do not need this file: change the values in the Docker Manager
# preview before deploying. Copy it to .env only if you run `docker compose` yourself.

# Public port of the menu (docker-compose.yml only). Open it in your firewall.
APP_PORT=8101

# Your menu's domain (docker-compose.traefik.yml only). Point its DNS to the VPS first.
APP_DOMAIN=menu.example.com

# Database passwords. Leave them empty: a random one is generated on the first start.
# Changing them after the first start has no effect (MySQL only reads them once).
MENUQR_DB_PASSWORD=
MENUQR_DB_ROOT_PASSWORD=

# Set to 1 to print a password recovery code in the logs. Set it back to 0 afterwards.
MENUQR_RECOVERY=0
